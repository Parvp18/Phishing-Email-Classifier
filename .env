# PhishGuard Environment Variables
# Copy this file to .env and fill in your values.

# VirusTotal API key (free tier: https://www.virustotal.com/gui/join-us)
VIRUSTOTAL_API_KEY=your_key_here

# Comma-separated list of valid API keys for authenticating requests
API_KEYS=your-secret-key-1,your-secret-key-2

# Flask secret key for session management
FLASK_SECRET_KEY=change-me-to-a-random-string
